# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ====================================================================
# SUPABASE DATABASE INTEGRATION (Real persistent PostgreSQL cloud storage)
# Obtain these from: https://supabase.com/dashboard/project/_/settings/api
# ====================================================================
# Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# API Key (Service Role Key or Public Anon Key)
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_OR_ANON_KEY"

# Optional client-side exposed keys for direct client queries
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
